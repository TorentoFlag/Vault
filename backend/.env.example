NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://vault:vault_password@localhost:55432/vault
REDIS_URL=redis://localhost:56379/0

# Arc Pay Hosted Checkout for Coins top-up.
# Secret values must live in files outside git, not in this env file.
ARC_PAY_ENVIRONMENT=sandbox
ARC_PAY_PROVIDER_MODE=real
ARC_PAY_SECRET_KEY_FILE=/absolute/path/to/vault-arc-pay-sandbox-secret-key
ARC_PAY_PUBLIC_ORIGIN=https://vault.example

# SIH provider secrets must also stay outside git.
SIH_API_KEY_FILE=/absolute/path/to/vault-sih-api-key
