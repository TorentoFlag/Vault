vaultapp24.com {
	@backend_exact path /auth/steam/start /auth/steam/callback /session/me /session/csrf /session/logout /me/steam-trade-url /me/steam-trade-url/status /wallet/me /wallet/me/transactions /checkout/cart /orders/me /inventory/me /fulfillment/me/trades /payments/top-up/sessions /payments/webhooks/arc-pay
	@backend_page_api {
		header Accept *application/json*
		path /catalog /cart /checkout
	}
	@backend_dynamic path_regexp backend_dynamic ^/(cart/items/[^/]+|inventory/me/items/[^/]+/withdrawals)$
	@backend_catalog_product_api {
		header Accept *application/json*
		path_regexp backend_catalog_product_api ^/catalog/[^/]+$
	}
	handle @backend_exact {
		reverse_proxy backend:3000
	}
	handle @backend_page_api {
		reverse_proxy backend:3000
	}
	handle @backend_dynamic {
		reverse_proxy backend:3000
	}
	handle @backend_catalog_product_api {
		reverse_proxy backend:3000
	}
	reverse_proxy frontend:3000
}

www.vaultapp24.com {
	redir https://vaultapp24.com{uri} permanent
}

api.vaultapp24.com {
	reverse_proxy backend:3000
}
